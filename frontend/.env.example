# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_BACKEND_URL=http://localhost:8000

# YouTube API Configuration (REQUIRED for real video content)
VITE_YOUTUBE_API_KEY=your_youtube_api_key

# Gemini AI API Configuration (OPTIONAL for intelligent course generation)
VITE_GEMINI_API_KEY=your_gemini_api_key

# OpenAI API Configuration (OPTIONAL for course generation)
VITE_OPENAI_API_KEY=your_openai_api_key

# Setup Instructions:
# 1. YouTube API Key (REQUIRED):
